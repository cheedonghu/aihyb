                    },
                    "eligibility": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "free_quota": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "amount": {
                          "anyOf": [

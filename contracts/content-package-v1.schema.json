                      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
                    "offer_kind": {
                      "enum": [
                        "subscription",
                        "api"
                      ]
                    },
                    "amount": {
                      "anyOf": [
                        {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 40,
                          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
                        },
                        {

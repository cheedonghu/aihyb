                              "type": "string",
                              "minLength": 1,
                              "maxLength": 40,
                              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "reset_period": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "condition": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        }
                      },
                      "required": [
                        "amount",
                        "unit",
                        "reset_period",
                        "condition"
                      ]
                    },
                    "limits": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 1000
                      },
                      "minItems": 0,
                      "maxItems": 30
                    },
                    "source_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80,
                      "pattern": "^[a-z0-9][a-z0-9-]{0,79}$"
                    },
                    "verified_at": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 40,
                      "format": "date-time"
                    },
                    "usage_quota": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "amount": {
                          "anyOf": [

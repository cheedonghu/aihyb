                              "type": "string",
                              "minLength": 1,
                              "maxLength": 40,
                              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]{1,12})?$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "reset_period": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 80
                        },
                        "condition": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 1000
                        }
                      },
                      "required": [
                        "amount",
                        "unit",
                        "reset_period",
                        "condition"
                      ]
                    },
                    "reset_rule": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 1000
                    },
                    "benefits": {
                      "type": "array",
                      "items": {
                        "type": "string",

  "components": {
    "schemas": {
      "AddOperation": {
        "type": "object",
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "add"
            ]
          },
          "path": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          },
          "value": {
            "description": "Value can be any JSON value"
          }
        },
        "required": [
          "op",
          "path",
          "value"
        ]
      },
      "Command": {
        "properties": {
          "action": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      },
      "Configuration": {
        "properties": {
          "configured": {
            "type": "boolean"
          },
          "max_bytes": {
            "type": "integer",
            "format": "int32"
          },
          "policy": {
            "type": "string"
          }
        }
      },
      "ContentPage": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublishedContent"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "CopyOperation": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          },
          "op": {
            "type": "string",
            "enum": [
              "copy"
            ]
          },
          "path": {
            "type": "string",
            "description": "A JSON Pointer path pointing to the location to move/copy from.",
            "example": "/a/b/c",
            "pattern": "^(/[^/~]*(~[01][^/~]*)*)*$"
          }
        },
        "required": [
          "from",
          "op",
          "path"
        ]
      },
      "EntryDetail": {
        "properties": {
          "draft_json": {
            "type": "string"
          },
          "entry": {
            "$ref": "#/components/schemas/EntrySummary"
          }
        }
      },
      "EntryPage": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntrySummary"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "EntrySummary": {
        "properties": {
          "content_id": {
            "type": "string"
          },
          "draft_revision": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "public_url": {
            "type": "string"
          },
          "published_revision": {
            "type": "string"
          },
          "reviewed_revision": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "History": {
        "properties": {
          "actor": {
            "type": "string"
          },
          "approved": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          },
          "draft": {
            "type": "boolean"
          },
          "published": {
            "type": "boolean"
          },
          "revision": {
            "type": "string"
          },
          "title": {
            "type": "string"
          }
        }
      },
      "HistoryPage": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/History"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "total": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "JsonPatch": {
        "type": "array",
        "description": "JSON schema for JSONPatch operations",
        "items": {
          "oneOf": [
            {
              "$ref": "#/components/schemas/AddOperation"
            },
            {
              "$ref": "#/components/schemas/ReplaceOperation"
            },
            {
              "$ref": "#/components/schemas/TestOperation"
            },
            {
              "$ref": "#/components/schemas/RemoveOperation"
            },
            {
              "$ref": "#/components/schemas/MoveOperation"
            },
            {
              "$ref": "#/components/schemas/CopyOperation"
            }
          ]
        },
        "minItems": 1,
        "uniqueItems": true
      },
      "MoveOperation": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",

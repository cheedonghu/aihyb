# Real .env is generated only on the server with permissions 0600.
# Runtime images are replaced by the pulled immutable RepoDigest values.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
HALO_IMAGE=halohub/halo:2.26.1
POSTGRES_IMAGE=postgres:17-bookworm

# Copy environment values from environments/test.env.example or production.env.example.
# Existing servers keep their own pinned images and private credentials.
